{
  "name": "andrepatrinicola.com",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/config",
    "packages/ui"
  ],
  "scripts": {
    "dev": "npm run dev:site",
    "dev:site": "npm run dev --workspace @andrepatrinicola/site",
    "build": "npm run build:site",
    "build:site": "npm run build --workspace @andrepatrinicola/site",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "concurrently": "^10.0.3"
  }
}
