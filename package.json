{
  "name": "andrepatrinicola.com",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "games/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:all",

    "dev:all": "concurrently --kill-others-on-fail --names site,tennis \"npm run dev:site\" \"npm run dev:tennis\"",

    "dev:site": "npm run dev --workspace @andrepatrinicola/site",
    "dev:tennis": "npm run dev --workspace @andrepatrinicola/tennis",

    "build": "npm run build:site && npm run build:games && npm run assemble",
    "build:site": "npm run build --workspace @andrepatrinicola/site",
    "build:games": "npm run build --workspace @andrepatrinicola/tennis",

    "assemble": "node scripts/assemble-deploy.mjs",

    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}