{
  "name": "andrepatrinicola.com",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "games/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:games && npm run dev:site",
    "dev:site": "npm run dev --workspace @andrepatrinicola/site",
    "dev:pong": "npm run dev --workspace @andrepatrinicola/pong",
    "dev:meteor": "npm run dev --workspace @andrepatrinicola/meteor",
    "dev:flappy": "npm run dev --workspace @andrepatrinicola/flappy",
    "dev:angryblocks": "npm run dev --workspace @andrepatrinicola/angryblocks",
    "build": "npm run build:site && npm run build:games && npm run assemble",
    "build:site": "npm run build --workspace @andrepatrinicola/site",
    "build:games": "npm run build --workspace @andrepatrinicola/pong && npm run build --workspace @andrepatrinicola/meteor && npm run build --workspace @andrepatrinicola/flappy && npm run build --workspace @andrepatrinicola/angryblocks",
    "assemble": "node scripts/assemble-deploy.mjs",
    "preview": "node scripts/serve-deploy.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test \"infra/**/*.test.mjs\"",
    "test:e2e": "npm run test:e2e --workspace @andrepatrinicola/site"
  },
  "devDependencies": {
    "playwright-core": "1.56.1"
  }
}
